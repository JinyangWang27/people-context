{
  "mcpServers": {
    "people-context": {
      "type": "stdio",
      "command": "uv",
      "cwd": ".",
      "args": [
        "run",
        "--no-dev",
        "--project",
        ".",
        "people-context-mcp"
      ],
      "env_vars": [
        "PEOPLE_CONTEXT_DB",
        "PEOPLE_CONTEXT_DB_KEY"
      ],
      "startup_timeout_sec": 120
    }
  }
}
